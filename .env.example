# Database Configuration
# Required: PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/scheduler?sslmode=disable

# Server Configuration
# Optional: Host to bind the server to (defaults to 0.0.0.0 if not set)
HOST=0.0.0.0
# Required: Port to run the server on
PORT=8080

# Authentication Configuration
# Optional: Comma-separated list of static tokens for legacy authentication
STATIC_TOKENS=token1,token2,token3

# Optional: JWT secret for HMAC signing (if using JWT authentication)
JWT_HMAC_SECRET=your-jwt-secret-key-here

# Google OAuth Configuration
# Optional: Google OAuth credentials for Calendar integration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://your-domain.com/oauth2callback
